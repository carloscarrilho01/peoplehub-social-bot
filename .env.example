# Variáveis do robô. Na Vercel elas ficam em Project Settings → Environment
# Variables. Localmente, copie para .env (só pra rodar `npm run preview`).

# --- IA (OpenAI) ---
OPENAI_API_KEY=            # texto (gpt-4o-mini) + imagem de fundo (gpt-image-1)

# --- Telegram ---
TELEGRAM_BOT_TOKEN=        # do @BotFather
TELEGRAM_CHAT_ID=         # seu chat id
TELEGRAM_WEBHOOK_SECRET=  # segredo que valida o webhook (invente um)

# --- Instagram (API with Instagram Login) ---
IG_USER_ID=               # id da conta (graph.instagram.com/me?fields=user_id)
IG_ACCESS_TOKEN=         # token IGAA... de longa duração
IG_HANDLE=@peoplehub      # aparece na arte

# --- Cron ---
CRON_SECRET=              # protege a rota /api/gerar (invente um)

# BLOB_READ_WRITE_TOKEN é injetado automaticamente pela integração Vercel Blob.
