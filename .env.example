# Copie para .env (uso local) OU cadastre como GitHub Secrets (uso na nuvem).

# --- Geração de conteúdo/arte (IA da OpenAI) ---
OPENAI_API_KEY=            # texto (gpt-4o-mini) + FUNDO da arte (gpt-image-1). Sem ela: texto de fallback e fundo gradiente da marca

# --- Telegram (aprovação) ---
TELEGRAM_BOT_TOKEN=        # do @BotFather
TELEGRAM_CHAT_ID=         # seu chat id (getUpdates)

# --- Instagram (publicação ao aprovar) — API with Instagram Login ---
IG_USER_ID=               # id da conta Instagram (obtido via graph.instagram.com/me)
IG_ACCESS_TOKEN=         # token de acesso do Instagram (IGAA...), de longa duração

# --- Opcionais ---
IG_HANDLE=@peoplehub      # aparece na arte
# REPO_RAW_BASE=          # base pública das imagens; em Actions é calculada sozinha
